# codescout retrieval stack — GPU profile (single CUDA card)
#
# Source this before running codescout / sync_project:
#   set -a; source .env.gpu; set +a
#
# Or pass to docker compose:
#   docker compose --profile gpu --env-file .env.gpu up -d

# Compose profile selector
CODESCOUT_RETRIEVAL_PROFILE=gpu

# Host directory holding the GGUF model file(s) — bind-mounted into dense-gpu
# and reranker-gpu at /models. Fetch/build both with:
#   ./scripts/fetch-models.sh --gpu
#   CodeRankEmbed-Q4_K_M.gguf         (90 MB)  — BUILT from nomic-ai/CodeRankEmbed.
#   bge-reranker-v2-m3-Q4_K_M.gguf    (419 MB) — gpustack/bge-reranker-v2-m3-GGUF
CODESCOUT_MODEL_DIR=./models

# ---- Codescout client wiring ----
CODESCOUT_QDRANT_URL=http://127.0.0.1:6334
CODESCOUT_EMBEDDER_URL=http://127.0.0.1:48081
CODESCOUT_EMBEDDER_MODEL_NAME=CodeRankEmbed-Q4_K_M.gguf
CODESCOUT_MODEL_DIM=768
# Q4_K_M is benchmarked best with NO query prefix (37, champion) — forcing the
# prefix drops to the f16+prefix tier (34). See docs/manual/src/concepts/
# retrieval-stack.md § Dense embedder: "We default to Q4 no-prefix."
# Uncomment only if switching the dense model to f16.
# CODESCOUT_QUERY_PREFIX="Represent this query for searching relevant code: "
CODESCOUT_SPARSE_EMBEDDER_URL=http://127.0.0.1:48084
CODESCOUT_RERANKER_URL=http://127.0.0.1:48083
# reranker-gpu is llama-server (not TEI), so the client must post the
# {query, documents} / relevance_score shape — Protocol::Infinity in
# src/retrieval/reranker.rs. Dropping this line silently falls back to the TEI
# shape and every rerank call fails.
CODESCOUT_RERANKER_PROTOCOL=llama-server
CODESCOUT_BM25_BOOST=3.0


# Librarian artifact embedder — OpenAI-compatible /v1 endpoint on the same dense
# model as the retrieval stack. Read separately from CODESCOUT_EMBEDDER_* by the
# librarian, so it must be set here too (that split caused the 2026-07-10 outage).
LIBRARIAN_EMBED_MODEL=CodeRankEmbed
LIBRARIAN_EMBED_URL=http://127.0.0.1:48081/v1
