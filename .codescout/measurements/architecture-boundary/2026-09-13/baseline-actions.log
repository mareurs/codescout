                      "type": "string"
                    },
                    "at": {
                      "enum": [
                        "end-of-section",
                        "after-heading-line"
                      ],
                      "type": "string"
                    },
                    "content": {
                      "description": "Markdown grammar: this entry's new section body. Stays `content`, not `body` \u2014 an item has no `frontmatter` sibling, so the tool-level rule does not reach it.",
                      "type": "string"
                    },
                    "heading": {
                      "description": "Markdown grammar: target section heading, or \"^\" for the PREAMBLE (action=\"edit\" only).",
                      "type": "string"
                    },
                    "include_subsections": {
                      "type": "boolean"
                    },
                    "new_string": {
                      "description": "Text grammar: replacement text.",
                      "type": "string"
                    },
                    "occurrence": {
                      "minimum": 1,
                      "type": "integer"
                    },
                    "old_string": {
                      "description": "Text grammar: exact text to find.",
                      "type": "string"
                    },
                    "replace_all": {
                      "type": "boolean"
                    }
                  },
                  "type": "object"
                },
                "type": "array"
              },
              "force": {
                "default": false,
                "description": "Markdown only: bypass the body-shrink guard. Required when the write would cut the file by >50% in bytes or lines.",
                "type": "boolean"
              },
              "frontmatter": {
                "description": "Markdown only: mutate the YAML frontmatter block at the start of the file. Flat keys only. Combinable atomically with `edits` or `heading`+`action` in the same call. Example: `{set: {status: \"fixed\"}, delete: [\"legacy_field\"]}`.",
                "properties": {
                  "delete": {
                    "description": "Keys to remove from the block. Missing keys are silently ignored (idempotent).",
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "set": {
                    "additionalProperties": true,
                    "description": "Key \u2192 value pairs to set. Existing keys are updated in place; new keys are appended.",
                    "type": "object"
                  }
                },
                "type": "object"
              },
              "heading": {
                "description": "Markdown only: target section heading (fuzzy matched). Required unless using edits[] batch mode. \"^\" targets the PREAMBLE (text before the first heading), action=\"edit\" only.",
                "type": "string"
              },
              "include_subsections": {
                "default": false,
                "description": "Markdown only, for action='replace': opt in to consuming nested sub-headings.",
                "type": "boolean"
              },
              "insert": {
                "description": "Insert at file start/end (old_string not required).",
                "enum": [
                  "prepend",
                  "append"
                ],
                "type": "string"
              },
              "new_string": {
                "description": "Replacement text (empty string = delete). Required for single-edit and insert modes.",
                "type": "string"
              },
              "occurrence": {
                "description": "Markdown only: 1-indexed selector when `heading` matches several sections.",
                "minimum": 1,
                "type": "integer"
              },
              "old_string": {
                "description": "Exact text to find (whitespace-sensitive). Required unless insert or edits is set.",
                "type": "string"
              },
              "path": {
                "description": "File path",
                "type": "string"
              },
              "replace_all": {
                "default": false,
                "description": "Replace all occurrences.",
                "type": "boolean"
              },
              "workspace": {
                "description": "Absolute workspace path to resolve this call against; omit for the active project. For concurrent subagents in different workspaces.",
                "type": "string"
              }
