                "items": {
                  "description": "Either the text grammar (old_string+new_string) or the markdown grammar (heading+action) \u2014 not mixed within one edits[] call.",
                  "properties": {
                    "action": {
                      "enum": [
                        "replace",
                        "insert_before",
                        "insert_after",
                        "remove",
                        "edit"
