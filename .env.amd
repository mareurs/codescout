# codescout retrieval stack — AMD ROCm profile
#
# Brings up qdrant + sparse-cpu + dense-amd + reranker-amd via codescout's own
# docker-compose. Dense and reranker run as `rocm/llama.cpp` containers with
# /dev/kfd + /dev/dri passthrough.
#
# Bring up:
#   cd ~/work/claude/code-explorer
#   docker compose --profile amd up -d
# Verify:
#   curl 127.0.0.1:48081/health   # dense (CodeRankEmbed on AMD)
#   curl 127.0.0.1:48083/health   # reranker (bge-reranker-v2-m3 on AMD)
#   curl 127.0.0.1:48084/health   # sparse SPLADE (CPU)
#   curl 127.0.0.1:6333/healthz   # qdrant
#
# Models needed in ${CODESCOUT_MODEL_DIR:-./models} — fetch with:
#   ./scripts/fetch-models.sh --amd
#   CodeRankEmbed-Q4_K_M.gguf         (90 MB)  — BUILT from nomic-ai/CodeRankEmbed.
#                                                No GGUF repo exists; the old
#                                                nomic-ai/CodeRankEmbed-GGUF 401s.
#   bge-reranker-v2-m3-Q4_K_M.gguf    (419 MB) — gpustack/bge-reranker-v2-m3-GGUF
#
# Source before running codescout:
#   set -a; source .env.amd; set +a

CODESCOUT_RETRIEVAL_PROFILE=amd

# ---- Codescout client wiring ----
CODESCOUT_QDRANT_URL=http://127.0.0.1:6334
CODESCOUT_EMBEDDER_URL=http://127.0.0.1:48081
CODESCOUT_EMBEDDER_MODEL_NAME=CodeRankEmbed-Q4_K_M.gguf
# Q4_K_M is benchmarked best with NO query prefix (37, champion) — forcing the
# prefix drops to the f16+prefix tier (34). See docs/manual/src/concepts/
# retrieval-stack.md § Dense embedder: "We default to Q4 no-prefix."
# Uncomment only if switching the dense model to f16.
# CODESCOUT_QUERY_PREFIX="Represent this query for searching relevant code: "
CODESCOUT_MODEL_DIM=768

CODESCOUT_SPARSE_EMBEDDER_URL=http://127.0.0.1:48084
# SPLADE sparse leg RE-ENABLED 2026-08-07. This file is the one that matters on this
# host: `~/.config/codescout/.env` is a symlink to it (verified 2026-08-07), so it is
# what the startup dotenv actually reads.
#
# Why the 2026-07-28 disable was reverted — three measurements, none of which held up
# the original rationale ("frees ~2.4 GiB VRAM"):
#   - the sparse container was up and healthy for 4 days holding 2.69 GiB of VRAM
#     regardless of this flag, so the flag freed nothing and only cost the ~2/75 eval
#     points we were already paying for;
#   - this host's active AMD card has 16 GiB with ~8.7 GiB free (the 6 GiB figure in
#     .env.gpu is the laptop's constraint, not this one's);
#   - the live collection already declares a `sparse` vector and 92.3% of a
#     2000-point sample carries populated sparse vectors, so no reindex gates the flip.
# Set it back to 1 on a host where ~2.7 GiB of VRAM does not fit.
# CODESCOUT_DISABLE_SPARSE=1

# Fusion multiplier for the sparse leg — LIVE again as of 2026-08-07. Measured on OUR
# corpus and dense model, not a universal default: 3.0 is the long-standing value and
# our own sweep peaked at 5.0 (35/75). Re-sweep with scripts/sweep-bm25-boost.sh
# rather than inheriting either. See memory `conventions` § Environment-Agnostic Tuning.
CODESCOUT_BM25_BOOST=3.0

CODESCOUT_RERANKER_URL=http://127.0.0.1:48083
CODESCOUT_RERANKER_PROTOCOL=llama-server


# Librarian artifact embedder — OpenAI-compatible /v1 endpoint on the same dense
# model as the retrieval stack. Read separately from CODESCOUT_EMBEDDER_* by the
# librarian, so it must be set here too (that split caused the 2026-07-10 outage).
LIBRARIAN_EMBED_MODEL=CodeRankEmbed
LIBRARIAN_EMBED_URL=http://127.0.0.1:48081/v1
