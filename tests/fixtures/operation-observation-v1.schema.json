{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Operation observation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "observation_id",
    "producer_instance",
    "sequence",
    "store_epoch",
    "event",
    "producer_kind",
    "workspace",
    "caller",
    "tool",
    "local_invocation",
    "native_call_id",
    "turn_id",
    "fingerprints",
    "targets",
    "outcome",
    "diagnostics",
    "observed_at_unix_ms"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "observation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[^\\u0000-\\u001f]+$"
    },
    "producer_instance": {
      "type": "string",
      "format": "uuid"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "store_epoch": {
      "type": "string",
      "format": "uuid"
    },
    "event": {
      "enum": [
        "request-observed",
        "dispatch-observed",
        "result-observed",
        "hook-pre",
        "hook-post",
        "lifecycle",
        "observer-diagnostic"
      ]
    },
    "producer_kind": {
      "enum": [
        "codex-hook",
        "codescout-server"
      ]
    },
    "workspace": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^/"
    },
    "caller": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "harness",
        "principal",
        "thread_id",
        "agent_id"
      ],
      "properties": {
        "harness": {
          "enum": [
            "codex",
            "unknown"
          ]
        },
        "principal": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "pattern": "^codex:.+"
            },
            {
              "type": "null"
            }
          ]
        },
        "thread_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "pattern": "^[^\\u0000-\\u001f]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "agent_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "pattern": "^[^\\u0000-\\u001f]+$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "tool": {
      "anyOf": [
        {
          "enum": [
            "create_file",
            "edit_file",
            "edit_code",
            "run_command",
            "read_file",
            "symbols",
            "grep",
            "semantic_search",
            "workspace",
            "doc",
            "memory",
            "find_file",
            "references",
            "call_graph",
            "symbol_at",
            "get_guide",
            "onboarding",
            "index",
            "execute",
            "exec_command",
            "shell",
            "code_mode"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "local_invocation": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[^\\u0000-\\u001f]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "native_call_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[^\\u0000-\\u001f]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "turn_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[^\\u0000-\\u001f]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "fingerprints": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "domain",
          "digest"
        ],
        "properties": {
          "domain": {
            "enum": [
              "canonical-json-safe-v1",
              "bytes-v1"
            ]
          },
          "digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "targets": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "phase",
          "bytes_len",
          "fingerprint"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^/",
            "maxLength": 4096
          },
          "phase": {
            "enum": [
              "attempted",
              "committed",
              "uncertain"
            ]
          },
          "bytes_len": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "fingerprint": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "domain",
                  "digest"
                ],
                "properties": {
                  "domain": {
                    "enum": [
                      "canonical-json-safe-v1",
                      "bytes-v1"
                    ]
                  },
                  "digest": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "outcome": {
      "enum": [
        "requested",
        "dispatched",
        "returned-success",
        "refused",
        "error-possible-effects",
        "missing-terminal",
        "unknown"
      ]
    },
    "diagnostics": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "enum": [
          "missing-root",
          "invalid-context",
          "context-conflict",
          "unsupported-tool",
          "unsupported-event",
          "incomplete-input",
          "opaque-effects",
          "missing-terminal",
          "unavailable",
          "disabled",
          "quota",
          "torn-record",
          "checksum",
          "sequence-gap",
          "conflicting-duplicate",
          "ambiguous-pair",
          "incompatible-schema",
          "checkout-mismatch",
          "reset",
          "unsupported-fingerprint"
        ]
      }
    },
    "observed_at_unix_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Capture wall clock for diagnostics and bounded reads, never causal order or authorization."
    },
    "native_cwd": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 4096,
          "pattern": "^/"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "producer_kind": {
            "const": "codex-hook"
          }
        }
      },
      "then": {
        "properties": {
          "caller": {
            "properties": {
              "harness": {
                "const": "codex"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "caller": {
            "properties": {
              "harness": {
                "const": "unknown"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "caller": {
            "properties": {
              "principal": {
                "type": "null"
              },
              "thread_id": {
                "type": "null"
              },
              "agent_id": {
                "type": "null"
              }
            }
          }
        }
      }
    }
  ]
}
