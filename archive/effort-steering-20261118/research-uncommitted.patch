+def validate_context_path(path):
+    """Admit only physical scratch paths without inherited project or user context."""
+    raw = pathlib.Path(path).absolute()
+    resolved = raw.resolve(strict=True)
+    bases = (pathlib.Path("/tmp"), pathlib.Path("/var/tmp"))
+    base = next((value for value in bases if resolved != value and value in resolved.parents), None)
+    if base is None or resolved != raw:
+        raise ValueError("external CLI context must have isolated physical scratch ancestry")
+    for parent in resolved.parents:
+        if any((parent / name).exists() or (parent / name).is_symlink()
+               for name in ("CLAUDE.md", "AGENTS.md", ".git", ".claude", "Cargo.toml")):
+            raise ValueError("external CLI context has inherited rules or workspace ancestry")
+        if parent == base:
+            break
+    if resolved.stat().st_uid != os.getuid():
+        raise ValueError("external CLI context is not owned scratch")
+    return resolved
+
+def context_preload(cfg, actor):
+    """Reconstruct the bound append-only system input before any credential read."""
+    if "context_preload" not in cfg:
+        return None
+    descriptor=cfg["context_preload"]
+    if not isinstance(descriptor,dict) or set(descriptor)!={"path","system_path","skill_path","files"}:
+        raise ValueError("invalid prepared context descriptor")
+    body_path=pathlib.Path(descriptor["path"])
+    system=pathlib.Path(descriptor["system_path"])
+    skill=pathlib.Path(descriptor["skill_path"])
+    target=actor/".codescout/prepared-context/reconnaissance"
+    if system!=actor/".codescout/system-prompt.md" or skill!=target/"SKILL.md":
+        raise ValueError("prepared context must name the actor's frozen onboarding and skill")
+    paths=[body_path,system,*target.rglob("*")]
+    if any(p.is_symlink() or not(p.is_file() or p.is_dir()) for p in paths):
+        raise ValueError("physical prepared context required")
+    files={str(p) for p in paths if p.is_file()}
+    if files!=set(descriptor["files"]):
+        raise ValueError("prepared context file coverage differs")
+    for name,digest in descriptor["files"].items():
+        p=pathlib.Path(name)
+        if (any(parent.is_symlink() for parent in p.parents) or cfg["files"].get(name)!=digest
+                or hashlib.sha256(p.read_bytes()).hexdigest()!=digest):
+            raise ValueError("prepared context hash coverage differs")
+    if not system.read_text().strip() or not skill.read_text().strip():
+        raise ValueError("nonempty prepared context required")
+    expected=("<prepared-context>\n<codescout-onboarding>\n"+system.read_text()+
+              "\n</codescout-onboarding>\n<reconnaissance-instructions>\n"
+              "Supporting files: .codescout/prepared-context/reconnaissance\n"+
+              skill.read_text()+"\n</reconnaissance-instructions>\n</prepared-context>\n")
+    body=body_path.read_text()
+    if body!=expected:
+        raise ValueError("prepared context body differs from frozen inputs")
+    return body
+
+def _public_build_helper(cfg):
+    """Load the hash-bound standalone helper only for the registered new profile."""
+    fields = {"public_build_inputs", "public_build_stage", "public_build_inputs_helper"}
+    selected = fields.intersection(cfg)
+    if not selected and cfg.get("execution_profile") != "cargo-v3":
+        return None
+    if selected != fields or cfg.get("execution_profile") != "cargo-v3":
+        raise ValueError("external public build contract incomplete or profile differs")
+    name = cfg["public_build_inputs_helper"]
+    if not isinstance(name, str):
+        raise ValueError("external public build helper path missing")
+    path = pathlib.Path(name)
+    if (not path.is_absolute() or path.resolve(strict=True) != path
+            or path.is_symlink() or not path.is_file()):
+        raise ValueError("external public build helper must be a physical frozen file")
+    data = path.read_bytes()
+    digest = hashlib.sha256(data).hexdigest()
+    if cfg.get("files", {}).get(str(path)) != digest:
+        raise ValueError("external public build helper hash missing or changed")
+    spec = importlib.util.spec_from_file_location("lifecycle_public_build_inputs_" + digest, path)
+    helper = importlib.util.module_from_spec(spec)
+    # Execute the exact bytes just checked, without adding their directory to sys.path.
+    exec(compile(data, str(path), "exec"), helper.__dict__)
+    return helper
+
+def public_build_contract(cfg, options, actor):
+    helper = _public_build_helper(cfg)
+    if helper is None:
