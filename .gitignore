# Narrowed from `/.github/` (4dac3a3c, 2026-03-03), which was added in the same
# commit that deleted .github/copilot-instructions.md — the intent was to stop that
# one generated file coming back, not to ignore CI. The broad rule made `git add`
# refuse new workflow files while the existing ones stayed tracked, since gitignore
# has no effect on paths already in the index.
/.github/copilot-instructions.md
/.worktrees/
/target
/.mcp.json
# codescout data dir: ignore generated/personal files, track shareable ones
# NOT ignored, deliberately: /.codescout/audit/*.jsonl are the committed audit
# shards (T-7). Adding a blanket `.codescout/` rule would silently stop sharing
# them, with no error anywhere — the same shape as the projects/ note above.
/.codescout/project.toml
/.codescout/index-state.json
/.codescout/embeddings.db
/.codescout/embeddings.db-wal
/.codescout/embeddings.db-shm
/.codescout/usage.db
/.codescout/usage.db-wal
/.codescout/usage.db-shm
/.codescout/librarian.db
/.codescout/librarian.db-wal
/.codescout/librarian.db-shm
# The same files again, for any crate with its own .codescout/ (one activated as its own project).
# Enumerated for the reason the "NOT ignored, deliberately" note above gives, and NOT a blanket
# rule plus a negation either: git will not descend into an excluded directory to reconsider one.
# This block is DERIVED from the root block above, never maintained by eye -- adding a root rule
# without its twin here reds `every_root_codescout_ignore_rule_has_its_crates_twin`
# (tests/hook_config.rs).
crates/*/.codescout/call_edges.db
crates/*/.codescout/cc_session_id
crates/*/.codescout/code-index.db
crates/*/.codescout/constitution-seen/
crates/*/.codescout/crash.log
crates/*/.codescout/debug.log*
crates/*/.codescout/diagnostic-*.log
crates/*/.codescout/embeddings.db
crates/*/.codescout/embeddings.db-shm
crates/*/.codescout/embeddings.db-wal
crates/*/.codescout/embeddings/
crates/*/.codescout/guide_hints/
crates/*/.codescout/index-state.json
crates/*/.codescout/librarian.db
crates/*/.codescout/librarian.db-shm
crates/*/.codescout/librarian.db-wal
crates/*/.codescout/libraries.json
crates/*/.codescout/peer-audit.jsonl
crates/*/.codescout/peers.toml
crates/*/.codescout/private-memories/
crates/*/.codescout/project.toml
crates/*/.codescout/tantivy/
crates/*/.codescout/tmp/
crates/*/.codescout/usage.db
crates/*/.codescout/usage.db-shm
crates/*/.codescout/usage.db-wal
crates/*/.codescout/usage.db.bak-*
