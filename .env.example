# Codescout retrieval stack — copy to .env and customize as needed.
#
# Three profiles are supported:
#   - AMD route (recommended on this workstation): reuse the llm-infra stack
#     at ~/agents/llm via `llm up`. Copy `.env.amd` instead of this file.
#   - GPU profile: self-contained docker-compose with nvidia. Copy `.env.gpu`.
#   - CPU profile: self-contained docker-compose, CPU-only. Copy `.env.cpu`.
#
# This example shows the CPU/GPU shape (default ports 48081/48083/48084/6334).
# The AMD route uses 43300/43400/43501/43600 — see .env.amd.

# URLs the codescout MCP server uses to talk to the stack.
CODESCOUT_QDRANT_URL=http://127.0.0.1:6334
CODESCOUT_EMBEDDER_URL=http://127.0.0.1:48081
CODESCOUT_SPARSE_EMBEDDER_URL=http://127.0.0.1:48084
CODESCOUT_RERANKER_URL=http://127.0.0.1:48083

# Profile in use. Must match `docker compose --profile <x> up`.
# Values: cpu | gpu | amd
CODESCOUT_RETRIEVAL_PROFILE=cpu

# Embedding dim — must match the model being served.
# CodeRankEmbed = 768, jina-v2-base-code = 768, bge-small = 384, jina-v2-small = 512.
CODESCOUT_MODEL_DIM=768

# Tuning knobs.
# See docs/research/2026-05-06-retrieval-stack-benchmark.md for the full table.
#
# AST chunk size in chars. 1200 ≈ one well-scoped function. Default: 1200.
# CODESCOUT_CHUNK_TARGET=1200
#
# Sparse-leg candidate pool multiplier in RRF fusion. MEASURED ON OUR SETUP — an
# observation, not a recommendation. On our 20-TC v2 suite, our corpus and our dense
# model, 3.0 beat balanced (1.0) by +4 pts; a later sweep peaked at 5.0 (35/75), and
# 3.0 stayed the default. A dense-vs-sparse fusion weight is corpus- and
# model-dependent by construction, so re-sweep on yours before trusting either
# number: scripts/sweep-bm25-boost.sh. Compiled default: 3.0.
# CODESCOUT_BM25_BOOST=3.0

# Skip the SPLADE sparse leg entirely — search becomes pure dense ANN, and the
# sparse vector is neither computed at index time nor queried. Set this if you
# do not want to run a sparse embedder service at all: SPLADE projects every
# token to a [tokens x 30522] vocab tensor, so it is by far the most
# VRAM-hungry service in the stack (~3.0 GiB peak at TEI's default
# --max-batch-tokens 16384, vs ~400 MiB for the dense embedder).
#
# The dense-only "lite" stack (in-process sqlite-vec + remote OpenAI embeddings,
# no Qdrant) relies on this being set.
#
# Cost on the pinned 25-TC bench: dense-only 32/75 vs hybrid 34/75 at boost 3.0.
# Switching this on later requires index(action="build", force=true) to backfill
# sparse vectors for chunks indexed while it was set.
#
# Default: off.
# CODESCOUT_DISABLE_SPARSE=1

# Dense embeddings are always OpenAI-compatible (`POST {url}/v1/embeddings`):
# llama-server, vLLM, Ollama, OpenAI proper, or a corporate gateway. Just set the
# model name the endpoint expects.
# CODESCOUT_EMBEDDER_MODEL_NAME=CodeRankEmbed

# Rerank-leg protocol (Stack A / hybrid only). `tei` (default) targets text-
# embeddings-inference's native `/rerank`. `llama-server` (alias: infinity, cohere)
# targets the Cohere-compatible `/rerank` exposed by llama-server's `--reranking` mode.
# CODESCOUT_RERANKER_PROTOCOL=tei


# --- Librarian artifact semantic search (embedded librarian) ---
# The librarian embeds tracker/spec/bug markdown for artifact(find, semantic=…)
# and librarian(context). It reads its OWN env surface (not CODESCOUT_EMBEDDER_*),
# so set it here. Point at any OpenAI-compatible /v1 embeddings endpoint.
# LIBRARIAN_EMBED_MODEL=CodeRankEmbed
# LIBRARIAN_EMBED_URL=http://127.0.0.1:48081/v1
# LIBRARIAN_EMBED_API_KEY=            # only if the endpoint requires it


# --- Server lifecycle ---
# Exit the stdio server after this many seconds with no tool call. Closes the
# accumulation described in docs/issues/2026-07-28-mcp-servers-outlive-their-clients.md:
# a client that is abandoned but not exited holds stdin open and stays alive, so neither
# EOF nor a signal ever arrives, and one server per stale session accumulates (18 measured,
# oldest 93.5h, ~1 GiB RSS in aggregate).
#
# Idle means "made no tool call". list_tools, resource reads and pings do NOT count, or a
# client polling capabilities would pin the server open forever.
#
# There is deliberately NO default, and this is not an oversight: how long your MCP server
# may sit idle is a property of YOUR workflow, and a server that exits while its client is
# merely quiet costs you a `/mcp` reconnect. Unset means the watchdog never fires and
# behaviour is unchanged. Pick a window longer than your longest expected pause between
# tool calls — hours, not minutes.
#
# The LSP mux's 180s is not a precedent: a mux is re-dialled transparently on the next
# navigation call, whereas an MCP server exiting is user-visible.
#
# Default: disabled.
# CODESCOUT_IDLE_SHUTDOWN_SECS=14400   # e.g. 4 hours
