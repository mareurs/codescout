+def validate_context_path(path):
+    """Admit only physical scratch paths without inherited project or user context."""
+    raw = pathlib.Path(path).absolute()
+    resolved = raw.resolve(strict=True)
+    bases = (pathlib.Path("/tmp"), pathlib.Path("/var/tmp"))
+    base = next((value for value in bases if resolved != value and value in resolved.parents), None)
