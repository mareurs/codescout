+    if any(p.is_symlink() or not(p.is_file() or p.is_dir()) for p in paths):
+        raise ValueError("physical prepared context required")
+    files={str(p) for p in paths if p.is_file()}
+    if files!=set(descriptor["files"]):
+        raise ValueError("prepared context file coverage differs")
+    for name,digest in descriptor["files"].items():
+        p=pathlib.Path(name)
+        if (any(parent.is_symlink() for parent in p.parents) or cfg["files"].get(name)!=digest
