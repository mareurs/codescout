diff --git a/probes/check_clone_boundary.py b/probes/check_clone_boundary.py
new file mode 100644
index 0000000..e06bad6
--- /dev/null
+++ b/probes/check_clone_boundary.py
@@ -0,0 +1,22 @@
+import sys
+
+src = open(sys.argv[1], encoding="utf-8").read()
+start = src.index("function _structuredClone(value, seen)")
+body = src[start:src.index("\nglobalThis", start) if "\nglobalThis" in src[start:] else start + 4000]
+err = body[body.index("value instanceof Error"):body.index("__obscura_clone_hooks")]
+gen = body[body.index("const out = Array.isArray(value)"):]
+checks = {
+    "error seen.set before cause": err.index("seen.set(value, e)") < err.index("_structuredClone(value.cause"),
+    "map/set record seen first": body.index("seen.set(value, m)") < body.index("m.set(_structuredClone")
+        and body.index("seen.set(value, s)") < body.index("s.add(_structuredClone"),
+    "clone hook path kept before generic": body.index("hook(value, seen)") < body.index("const out ="),
+    "function/symbol rejection kept": "DataCloneError" in body[:400],
+    "typed array/DataView/ArrayBuffer kept": all(t in body for t in ("DataView", "value.slice()", "value instanceof ArrayBuffer")),
+    "plain base is {} and arrays kept": "Array.isArray(value) ? [] : {}" in gen,
+    "string keys defined, not assigned": "Object.defineProperty(out, k" in gen and "out[k] =" not in gen,
+    "own-property filter kept": "hasOwnProperty.call(value, k)" in gen,
+    "symbol keys still copied": "getOwnPropertySymbols" in gen,
+}
+for k, v in checks.items():
+    print(k + ":", v)
+sys.exit(0 if all(checks.values()) else 1)
