+import re, sys
+src = open(sys.argv[1], encoding="utf-8").read()
+start = src.index("function _structuredClone(")
+body = src[start:start + 4000]
+i = body.index("value instanceof Error")
+blk = body[i:body.index("return e;", i)]
+print("error-branch:\n" + blk)
+ok_seen = "seen.set(value, e)" in blk
+print("error branch records seen before cause recursion:", ok_seen)
+g = body[body.index("Object.create(Object.getPrototypeOf(value))") - 80:][:600]
+print("generic branch:\n" + g)
+assign = "out[k] = _structuredClone" in body
+print("generic branch uses assignment:", assign)
+sys.exit(0 if ok_seen and not assign else 1)
