+/// A cached upstream error must replay with its original status. The cache-hit
+/// path used to rebuild a bare `Response`, so a cached 429 came back as 200 OK.
+/// No upstream is reachable here: only the cache can answer.
+#[tokio::test]
+#[allow(clippy::await_holding_lock)]
+async fn cached_upstream_error_replays_with_original_status() {
+    use crate::core::ocla::response_cache::ResponseCache;
+    use crate::proxy::ocla_cache_bridge::{OclaCacheBridge, prompt_hash};
+
+    let _lock = crate::core::data_dir::test_env_lock();
+    let tmp = tempfile::tempdir().unwrap();
+    crate::test_env::set_var("LEAN_CTX_DATA_DIR", tmp.path());
+    crate::proxy::policy_gate::test_set_rules(None);
+
+    let request_body = serde_json::to_vec(&serde_json::json!({
+        "model": "gpt-5",
+        "messages": [{"role": "user", "content": "explain caching"}]
+    }))
+    .unwrap();
+    let error_body = br#"{"error":{"message":"rate limited"}}"#;
+
+    let bridge = Arc::new(OclaCacheBridge::new(Arc::new(ResponseCache::new(
+        4,
+        std::time::Duration::from_mins(1),
+    ))));
+    bridge.record_response(
+        "gpt-5",
+        &prompt_hash(&request_body),
+        0.0,
+        0,
+        StatusCode::TOO_MANY_REQUESTS,
+        error_body,
+        3,
+    );
+
+    let (_tx, rx) = tokio::sync::watch::channel(Arc::new(crate::proxy::Upstreams {
+        anthropic: "https://api.anthropic.com".into(),
+        openai: "https://api.openai.com".into(),
+        chatgpt: "https://chatgpt.com".into(),
+        gemini: "https://generativelanguage.googleapis.com".into(),
+        providers: Vec::new(),
+    }));
+    let state = ProxyState {
+        client: reqwest::Client::new(),
+        port: 0,
+        stats: Arc::new(crate::proxy::ProxyStats::default()),
+        introspect: Arc::new(crate::proxy::introspect::IntrospectState::default()),
+        ocla_cache: Some(bridge),
+        upstreams: rx,
+        chatgpt_cookies: crate::proxy::chatgpt_cookies::shared_chatgpt_cloudflare_cookie_store(),
+        mcp_servers: Arc::new(Vec::new()),
+    };
+    let request = Request::builder()
+        .method("POST")
+        .uri("/v1/chat/completions")
+        .header("content-type", "application/json")
+        .body(Body::from(request_body))
+        .unwrap();
+
+    let response = forward_request(
+        State(state),
+        request,
+        "https://api.openai.com",
+        "/v1/chat/completions",
+        add_test_marker,
+        "OpenAI",
+        &[],
+    )
+    .await
+    .expect("a cache hit answers without contacting the upstream");
+
+    assert_eq!(response.status(), StatusCode::TOO_MANY_REQUESTS);
+    let body = axum::body::to_bytes(response.into_body(), usize::MAX)
+        .await
+        .unwrap();
+    assert_eq!(&body[..], error_body);
+
+    crate::proxy::policy_gate::test_clear_rules();
+    crate::test_env::remove_var("LEAN_CTX_DATA_DIR");
+}
 
